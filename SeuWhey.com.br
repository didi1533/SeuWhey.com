<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hiper Calórico | Growth Supplements — de R$120 por R$67,90</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --purple-deep:#2C1653;
    --purple-mid:#4A2394;
    --purple-bright:#7C3FE0;
    --black:#0E0B14;
    --black-soft:#17131F;
    --gold:#CBB877;
    --choc:#7A4430;
    --choc-dark:#4A281C;
    --cream:#F5EFE4;
    --pix:#1FA35C;
    --pix-dark:#0F7A41;
    --morango:#E24E7A;
    --baunilha:#E8C77E;
    --line:rgba(245,239,228,0.14);
    --shadow:0 30px 60px -20px rgba(0,0,0,0.6);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Manrope',sans-serif;
    background:var(--black);
    color:var(--cream);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{max-width:100%; display:block;}
  .display{font-family:'Anton',sans-serif; text-transform:uppercase; letter-spacing:0.01em;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 24px;}
  a{color:inherit;}

  /* reduced motion */
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  /* ---------- topo urgência ---------- */
  .urgency-bar{
    background:linear-gradient(90deg, var(--pix-dark), var(--pix));
    color:#fff; text-align:center; font-family:'JetBrains Mono',monospace;
    font-size:13px; font-weight:600; letter-spacing:0.03em;
    padding:9px 12px;
  }
  .urgency-bar span{opacity:0.85; font-weight:400;}

  /* ---------- nav ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(14,11,20,0.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav{display:flex; align-items:center; justify-content:space-between; padding:16px 24px;}
  .logo{display:flex; align-items:center; gap:10px; font-family:'Anton',sans-serif; font-size:20px; letter-spacing:0.02em;}
  .logo .dot{width:10px; height:10px; border-radius:2px; background:var(--gold); transform:rotate(45deg);}
  .navlinks{display:flex; gap:32px; font-size:14px; font-weight:600;}
  .navlinks a{opacity:0.75; text-decoration:none; transition:opacity .2s;}
  .navlinks a:hover{opacity:1;}
  .nav-cta{
    background:var(--gold); color:var(--black); font-weight:800; font-size:14px;
    padding:10px 20px; border-radius:100px; text-decoration:none; white-space:nowrap;
    transition:transform .15s ease;
  }
  .nav-cta:hover{transform:translateY(-2px);}
  @media(max-width:820px){ .navlinks{display:none;} }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    background:
      radial-gradient(ellipse 900px 500px at 78% 15%, rgba(124,63,224,0.35), transparent 60%),
      linear-gradient(180deg, var(--black) 0%, var(--purple-deep) 55%, var(--black-soft) 100%);
    padding:64px 0 40px;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0;
    background-image: radial-gradient(circle, rgba(245,239,228,0.06) 1px, transparent 1.4px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 20%, black, transparent);
    pointer-events:none;
  }
  .hero-grid{
    display:grid; grid-template-columns:1.05fr 0.95fr; gap:40px; align-items:center;
    position:relative; z-index:2;
  }
  @media(max-width:900px){ .hero-grid{grid-template-columns:1fr; text-align:center;} }

  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase; color:var(--gold);
    border:1px solid rgba(203,184,119,0.4); padding:6px 14px; border-radius:100px;
    margin-bottom:22px; background:rgba(203,184,119,0.08);
  }
  .eyebrow::before{content:"●"; color:var(--pix); font-size:8px;}

  h1.hero-title{
    font-size:clamp(40px, 6vw, 74px);
    line-height:0.94;
    color:#fff;
    margin-bottom:18px;
  }
  h1.hero-title .accent{
    background:linear-gradient(90deg, var(--gold), #E9DDA8);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero-sub{
    font-size:18px; line-height:1.55; color:rgba(245,239,228,0.78);
    max-width:480px; margin-bottom:30px;
  }
  @media(max-width:900px){ .hero-sub{margin-left:auto; margin-right:auto;} }

  .price-block{
    display:flex; align-items:flex-end; gap:16px; margin-bottom:26px; flex-wrap:wrap;
  }
  @media(max-width:900px){ .price-block{justify-content:center;} }
  .price-old{
    font-family:'JetBrains Mono',monospace; font-size:20px; color:rgba(245,239,228,0.5);
    position:relative;
  }
  .price-old::after{
    content:""; position:absolute; left:-4px; right:-4px; top:50%; height:2px;
    background:var(--morango); transform:rotate(-6deg);
  }
  .price-new{font-family:'Anton',sans-serif; font-size:56px; color:#fff; line-height:1;}
  .price-new small{font-family:'Manrope',sans-serif; font-size:18px; font-weight:700; vertical-align:top;}
  .price-tag{
    background:var(--pix); color:#fff; font-family:'JetBrains Mono',monospace;
    font-weight:700; font-size:13px; padding:6px 12px; border-radius:8px;
    align-self:center;
  }

  .hero-ctas{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:30px;}
  @media(max-width:900px){ .hero-ctas{justify-content:center;} }
  .btn-primary{
    background:linear-gradient(90deg, var(--gold), #DFCB8E);
    color:var(--black); font-weight:800; font-size:16px;
    padding:16px 30px; border-radius:100px; text-decoration:none;
    border:none; cursor:pointer;
    box-shadow:0 12px 30px -8px rgba(203,184,119,0.55);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn-primary:hover{transform:translateY(-3px); box-shadow:0 16px 34px -6px rgba(203,184,119,0.7);}
  .btn-secondary{
    background:transparent; color:#fff; font-weight:700; font-size:16px;
    padding:16px 26px; border-radius:100px; border:1px solid rgba(245,239,228,0.3);
    text-decoration:none; transition:border-color .15s ease, background .15s ease;
  }
  .btn-secondary:hover{border-color:#fff; background:rgba(255,255,255,0.06);}

  .hero-trust{display:flex; gap:22px; flex-wrap:wrap; font-size:13px; color:rgba(245,239,228,0.65);}
  @media(max-width:900px){ .hero-trust{justify-content:center;} }
  .hero-trust span{display:flex; align-items:center; gap:6px;}

  /* product visual */
  .hero-visual{position:relative; display:flex; justify-content:center; align-items:center;}
  .glow{
    position:absolute; width:420px; height:420px; border-radius:50%;
    background:radial-gradient(circle, rgba(124,63,224,0.55), transparent 65%);
    filter:blur(10px); z-index:0;
  }
  .product-shot{
    position:relative; z-index:1; width:min(380px, 78vw);
    filter:drop-shadow(0 30px 40px rgba(0,0,0,0.55));
    transition:filter .4s ease;
    animation:float 5s ease-in-out infinite;
  }
  @keyframes float{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-14px);} }
  @media (prefers-reduced-motion: reduce){ .product-shot{animation:none;} }
  .badge-corte{
    position:absolute; top:6%; right:2%; z-index:2;
    background:var(--morango); color:#fff; font-family:'Anton',sans-serif;
    font-size:15px; padding:12px; border-radius:50%; width:74px; height:74px;
    display:flex; align-items:center; justify-content:center; text-align:center; line-height:1.05;
    transform:rotate(10deg); box-shadow:var(--shadow);
  }

  /* ---------- trust strip ---------- */
  .trust-strip{
    background:var(--black-soft); border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    padding:22px 0;
  }
  .trust-strip .wrap{display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap;}
  .trust-item{display:flex; align-items:center; gap:12px; flex:1; min-width:220px;}
  .trust-item .ic{
    width:38px; height:38px; border-radius:10px; background:rgba(203,184,119,0.12);
    display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--gold); font-size:18px;
  }
  .trust-item h4{font-size:14px; font-weight:800; margin-bottom:2px;}
  .trust-item p{font-size:12.5px; color:rgba(245,239,228,0.6);}

  /* ---------- section shared ---------- */
  section{padding:88px 0;}
  .section-head{text-align:center; max-width:640px; margin:0 auto 48px;}
  .section-eyebrow{
    font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; letter-spacing:0.1em;
    text-transform:uppercase; color:var(--purple-bright); margin-bottom:10px; display:block;
  }
  .section-title{font-size:clamp(30px,4vw,44px); color:#fff; margin-bottom:14px; line-height:1.05;}
  .section-sub{font-size:16px; color:rgba(245,239,228,0.65); line-height:1.6;}

  /* ---------- sabores ---------- */
  #sabores{background:linear-gradient(180deg, var(--black) 0%, #150F22 100%);}
  .flavor-stage{
    display:grid; grid-template-columns:0.85fr 1.15fr; gap:56px; align-items:center;
  }
  @media(max-width:900px){ .flavor-stage{grid-template-columns:1fr;} }
  .flavor-visual{position:relative; display:flex; justify-content:center;}
  .flavor-visual img{
    width:min(340px,80vw);
    filter:drop-shadow(0 26px 34px rgba(0,0,0,0.55)) hue-rotate(0deg) saturate(1);
    transition:filter .5s ease;
  }
  .scoop-note{
    position:absolute; bottom:6px; left:50%; transform:translateX(-50%);
    background:rgba(14,11,20,0.85); border:1px solid var(--line); backdrop-filter:blur(6px);
    padding:8px 16px; border-radius:100px; font-size:12.5px; font-family:'JetBrains Mono',monospace;
    color:var(--cream); white-space:nowrap;
  }
  .flavor-list{display:flex; flex-direction:column; gap:14px;}
  .flavor-card{
    display:flex; align-items:center; gap:16px;
    border:1px solid var(--line); border-radius:16px; padding:18px 20px;
    cursor:pointer; background:rgba(245,239,228,0.02);
    transition:border-color .2s ease, background .2s ease, transform .15s ease;
  }
  .flavor-card:hover{transform:translateX(4px);}
  .flavor-card.active{border-color:var(--gold); background:rgba(203,184,119,0.08);}
  .swatch{width:44px; height:44px; border-radius:50%; flex-shrink:0; box-shadow:inset 0 0 0 3px rgba(255,255,255,0.15);}
  .swatch.choc{background:linear-gradient(135deg,#7A4430,#3A2015);}
  .swatch.morango{background:linear-gradient(135deg,#F0759A,#B62955);}
  .swatch.baunilha{background:linear-gradient(135deg,#F3E3B8,#C7A85C);}
  .flavor-card h4{font-size:16px; margin-bottom:3px;}
  .flavor-card p{font-size:13px; color:rgba(245,239,228,0.55);}
  .flavor-card .fprice{font-family:'JetBrains Mono',monospace; font-size:12.5px; margin-top:4px;}
  .flavor-card .fprice .old{color:rgba(245,239,228,0.4); text-decoration:line-through; margin-right:6px;}
  .flavor-card .fprice .new{color:var(--gold); font-weight:700;}
  .flavor-card .check{
    margin-left:auto; width:22px; height:22px; border-radius:50%; border:2px solid rgba(245,239,228,0.3);
    display:flex; align-items:center; justify-content:center; font-size:12px; flex-shrink:0;
  }
  .flavor-card.active .check{background:var(--gold); border-color:var(--gold); color:var(--black); font-weight:800;}

  /* ---------- ficha nutricional ---------- */
  #ficha{background:var(--black-soft);}
  .ficha-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;}
  @media(max-width:900px){ .ficha-grid{grid-template-columns:1fr;} }
  .ficha-grid img{border-radius:18px; box-shadow:var(--shadow); border:1px solid var(--line);}
  .stat-row{display:flex; gap:14px; margin-top:28px; flex-wrap:wrap;}
  .stat{
    flex:1; min-width:120px; border:1px solid var(--line); border-radius:14px; padding:16px;
    background:rgba(245,239,228,0.02);
  }
  .stat .num{font-family:'Anton',sans-serif; font-size:30px; color:var(--gold);}
  .stat .lbl{font-size:12.5px; color:rgba(245,239,228,0.6); margin-top:2px;}
  .ficha-list{list-style:none; margin-top:22px; display:flex; flex-direction:column; gap:12px;}
  .ficha-list li{display:flex; gap:12px; font-size:14.5px; color:rgba(245,239,228,0.8); align-items:flex-start;}
  .ficha-list li::before{content:"✓"; color:var(--pix); font-weight:800; flex-shrink:0;}

  /* ---------- checkout ---------- */
  #comprar{
    background:
      radial-gradient(ellipse 700px 400px at 20% 0%, rgba(124,63,224,0.3), transparent 60%),
      linear-gradient(180deg, #150F22 0%, var(--purple-deep) 100%);
  }
  .checkout-card{
    max-width:620px; margin:0 auto;
    background:var(--black-soft); border:1px solid var(--line); border-radius:24px;
    padding:36px; box-shadow:var(--shadow);
  }
  .checkout-top{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; gap:16px;}
  .checkout-top h3{font-size:20px; margin-bottom:4px;}
  .checkout-top p{font-size:13px; color:rgba(245,239,228,0.55);}
  .checkout-price{text-align:right; flex-shrink:0;}
  .checkout-price .old{font-family:'JetBrains Mono',monospace; font-size:13px; color:rgba(245,239,228,0.45); text-decoration:line-through;}
  .checkout-price .new{font-family:'Anton',sans-serif; font-size:32px; color:var(--gold);}

  .field-label{font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:rgba(245,239,228,0.6); margin:20px 0 10px;}
  .qty-options, .pay-options{display:flex; gap:10px; flex-wrap:wrap;}
  .opt{
    flex:1; min-width:110px; text-align:center; border:1px solid var(--line); border-radius:12px;
    padding:12px 10px; cursor:pointer; font-size:13.5px; font-weight:700;
    transition:border-color .2s ease, background .2s ease;
  }
  .opt:hover{border-color:rgba(245,239,228,0.4);}
  .opt.active{border-color:var(--gold); background:rgba(203,184,119,0.1);}
  .opt small{display:block; font-weight:400; font-size:11px; color:rgba(245,239,228,0.5); margin-top:3px;}
  .opt.pix.active{border-color:var(--pix); background:rgba(31,163,92,0.14);}

  .total-row{
    display:flex; justify-content:space-between; align-items:center;
    margin:26px 0 6px; padding-top:18px; border-top:1px dashed var(--line);
  }
  .total-row .lbl{font-size:14px; color:rgba(245,239,228,0.6);}
  .total-row .val{font-family:'Anton',sans-serif; font-size:30px; color:#fff;}
  .total-row .val small{font-family:'Manrope',sans-serif; font-size:13px; color:var(--pix); font-weight:700; display:block; text-align:right;}

  .btn-buy{
    width:100%; margin-top:18px; background:linear-gradient(90deg,var(--gold),#E4D29A);
    color:var(--black); font-weight:800; font-size:17px; padding:18px; border:none;
    border-radius:100px; cursor:pointer; box-shadow:0 14px 30px -10px rgba(203,184,119,0.6);
    transition:transform .15s ease;
  }
  .btn-buy:hover{transform:translateY(-2px);}

  /* ---------- pix modal ---------- */
  .pix-overlay{
    display:none; position:fixed; inset:0; z-index:100;
    background:rgba(8,6,12,0.78); backdrop-filter:blur(6px);
    align-items:center; justify-content:center; padding:20px;
  }
  .pix-overlay.open{display:flex;}
  .pix-modal{
    width:100%; max-width:420px; max-height:92vh; overflow-y:auto;
    background:var(--black-soft); border:1px solid var(--line); border-radius:22px;
    padding:28px; box-shadow:var(--shadow); position:relative;
  }
  .pix-close{
    position:absolute; top:16px; right:16px; width:32px; height:32px; border-radius:50%;
    border:1px solid var(--line); background:transparent; color:var(--cream); cursor:pointer;
    font-size:16px; line-height:1; display:flex; align-items:center; justify-content:center;
  }
  .pix-close:hover{border-color:var(--gold); color:var(--gold);}
  .pix-head{text-align:center; margin-bottom:18px;}
  .pix-head .ic{font-size:30px; margin-bottom:8px;}
  .pix-head h3{font-size:19px; color:#fff; margin-bottom:4px;}
  .pix-head p{font-size:13px; color:rgba(245,239,228,0.6);}
  .pix-summary{
    display:flex; justify-content:space-between; align-items:center;
    background:rgba(245,239,228,0.03); border:1px solid var(--line); border-radius:14px;
    padding:14px 16px; margin-bottom:20px;
  }
  .pix-summary .l{font-size:13px; color:rgba(245,239,228,0.6);}
  .pix-summary .v{font-family:'Anton',sans-serif; font-size:22px; color:var(--gold);}
  .pix-qr-wrap{
    display:flex; justify-content:center; padding:16px; background:#fff; border-radius:16px; margin-bottom:18px;
  }
  #pixQrcode img{display:block; border-radius:4px;}
  .pix-code-label{font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:rgba(245,239,228,0.55); margin-bottom:8px;}
  .pix-code-box{
    display:flex; gap:8px; align-items:stretch; margin-bottom:18px;
  }
  .pix-code-box textarea{
    flex:1; resize:none; height:56px; background:rgba(245,239,228,0.04); border:1px solid var(--line);
    border-radius:12px; color:rgba(245,239,228,0.75); font-family:'JetBrains Mono',monospace; font-size:11px;
    padding:10px; line-height:1.4;
  }
  .pix-copy-btn{
    flex-shrink:0; width:64px; border:none; border-radius:12px; background:var(--pix); color:#fff;
    font-weight:800; font-size:12px; cursor:pointer; transition:background .2s ease;
  }
  .pix-copy-btn:hover{background:var(--pix-dark);}
  .pix-copy-btn.copied{background:var(--gold); color:var(--black);}
  .pix-steps{list-style:none; display:flex; flex-direction:column; gap:8px; margin-bottom:4px;}
  .pix-steps li{display:flex; gap:10px; font-size:13px; color:rgba(245,239,228,0.7); align-items:flex-start;}
  .pix-steps .n{
    flex-shrink:0; width:20px; height:20px; border-radius:50%; background:rgba(203,184,119,0.15);
    color:var(--gold); font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700;
    display:flex; align-items:center; justify-content:center;
  }
  .checkout-foot{display:flex; justify-content:center; gap:18px; margin-top:16px; font-size:12px; color:rgba(245,239,228,0.5); flex-wrap:wrap;}

  /* ---------- selos ---------- */
  #selos{padding:64px 0;}
  .selo-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  @media(max-width:820px){ .selo-grid{grid-template-columns:repeat(2,1fr);} }
  .selo{
    text-align:center; padding:26px 14px; border:1px solid var(--line); border-radius:16px;
    background:rgba(245,239,228,0.02);
  }
  .selo .ic{font-size:26px; margin-bottom:10px;}
  .selo h5{font-size:13.5px; font-weight:800; margin-bottom:4px;}
  .selo p{font-size:11.5px; color:rgba(245,239,228,0.5);}

  /* ---------- FAQ ---------- */
  #faq{background:var(--black-soft);}
  .faq-item{border-bottom:1px solid var(--line); padding:20px 0;}
  .faq-q{
    display:flex; justify-content:space-between; align-items:center; cursor:pointer;
    font-size:16px; font-weight:700; gap:16px;
  }
  .faq-q .plus{font-size:22px; color:var(--gold); transition:transform .25s ease; flex-shrink:0;}
  .faq-item.open .faq-q .plus{transform:rotate(45deg);}
  .faq-a{
    max-height:0; overflow:hidden; transition:max-height .3s ease;
    font-size:14.5px; color:rgba(245,239,228,0.65); line-height:1.6;
  }
  .faq-item.open .faq-a{max-height:200px; margin-top:12px;}

  /* ---------- footer ---------- */
  footer{padding:48px 0 30px; border-top:1px solid var(--line);}
  .foot-grid{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;}
  .foot-grid p{font-size:12.5px; color:rgba(245,239,228,0.45);}
  .foot-badges{display:flex; gap:10px; font-family:'JetBrains Mono',monospace; font-size:11px; color:rgba(245,239,228,0.5);}

  /* sticky mobile buy bar */
  .mobile-bar{
    display:none; position:fixed; left:0; right:0; bottom:0; z-index:60;
    background:rgba(14,11,20,0.95); backdrop-filter:blur(10px);
    border-top:1px solid var(--line); padding:12px 16px;
    align-items:center; justify-content:space-between; gap:12px;
  }
  .mobile-bar .p{font-family:'Anton',sans-serif; font-size:20px; color:var(--gold);}
  .mobile-bar a{
    background:var(--gold); color:var(--black); font-weight:800; font-size:14px;
    padding:12px 22px; border-radius:100px; text-decoration:none;
  }
  @media(max-width:640px){ .mobile-bar{display:flex;} body{padding-bottom:64px;} }

  :focus-visible{outline:2px solid var(--gold); outline-offset:2px;}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>

<div class="urgency-bar">🔥 OFERTA RELÂMPAGO — de R$120,00 por <strong>R$67,90</strong> <span>· estoque limitado · envio imediato para todo o Brasil</span></div>

<header>
  <nav class="wrap">
    <div class="logo"><span class="dot"></span>GROWTH<span style="color:var(--gold)">.</span></div>
    <div class="navlinks">
      <a href="#sabores">Sabores</a>
      <a href="#ficha">Ficha nutricional</a>
      <a href="#comprar">Pagamento</a>
      <a href="#faq">Dúvidas</a>
    </div>
    <a href="#comprar" class="nav-cta">Comprar agora</a>
  </nav>
</header>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Suplemento hipercalórico em pó</div>
      <h1 class="hero-title">GANHE MASSA<br>SEM PESAR<br><span class="accent">NO BOLSO.</span></h1>
      <p class="hero-sub">347 kcal e 24g de proteína por dose. O mesmo Hiper Calórico das academias, direto de fábrica para sua casa — sem intermediário, sem preço abusivo.</p>

      <div class="price-block">
        <span class="price-old mono">R$ 120,00</span>
        <span class="price-new">R$ 67,90 <small>/ 1kg</small></span>
        <span class="price-tag">−43% hoje</span>
      </div>

      <div class="hero-ctas">
        <a href="#comprar" class="btn-primary">Quero o meu por R$ 67,90</a>
        <a href="#sabores" class="btn-secondary">Ver sabores</a>
      </div>

      <div class="hero-trust">
        <span>💚 5% off no Pix</span>
        <span>🚚 Envio imediato</span>
        <span>🔒 Compra 100% segura</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="glow"></div>
      <img class="product-shot" id="heroImg" src="data:image/jpeg;base64," alt="Pacote de Hiper Calórico Growth Supplements, sabor chocolate, 1kg">
      <div class="badge-corte">−43%<br>OFF</div>
    </div>
  </div>
</section>

<div class="trust-strip">
  <div class="wrap">
    <div class="trust-item"><div class="ic">💳</div><div><h4>Pix com desconto</h4><p>5% off pagando via Pix</p></div></div>
    <div class="trust-item"><div class="ic">📦</div><div><h4>Envio imediato</h4><p>Pedido despachado em até 24h</p></div></div>
    <div class="trust-item"><div class="ic">🍫</div><div><h4>3 sabores</h4><p>Chocolate, morango e baunilha</p></div></div>
    <div class="trust-item"><div class="ic">🏆</div><div><h4>Qualidade Growth</h4><p>Certificação internacional</p></div></div>
  </div>
</div>

<section id="sabores">
  <div class="wrap">
    <div class="section-head">
      <span class="section-eyebrow">Escolha o seu</span>
      <h2 class="section-title">Sabor de verdade,<br>em cada dosador.</h2>
      <p class="section-sub">Toque em um sabor para visualizar o pacote. Todos com a mesma fórmula: 347 kcal e 24g de proteína por porção de 90g.</p>
    </div>

    <div class="flavor-stage">
      <div class="flavor-visual">
        <img id="flavorImg" src="data:image/jpeg;base64," alt="Dosador de Hiper Calórico sendo retirado do pacote">
        <div class="scoop-note" id="flavorNote">sabor selecionado: chocolate</div>
      </div>

      <div class="flavor-list">
        <div class="flavor-card active" data-flavor="chocolate" data-old="120.00" data-new="67.90" data-scoop="data:image/jpeg;base64," data-filter="hue-rotate(0deg) saturate(1)">
          <div class="swatch choc"></div>
          <div>
            <h4>Chocolate</h4>
            <p>O clássico. Cremoso e intenso.</p>
            <div class="fprice"><span class="old">R$ 120,00</span><span class="new">R$ 67,90</span></div>
          </div>
          <div class="check">✓</div>
        </div>
        <div class="flavor-card" data-flavor="morango" data-old="120.00" data-new="67.90" data-scoop="" data-filter="hue-rotate(200deg) saturate(1.5) brightness(1.05)">
          <div class="swatch morango"></div>
          <div>
            <h4>Morango</h4>
            <p>Doce na medida, sabor marcante.</p>
            <div class="fprice"><span class="old">R$ 120,00</span><span class="new">R$ 67,90</span></div>
          </div>
          <div class="check">✓</div>
        </div>
        <div class="flavor-card" data-flavor="baunilha" data-old="110.00" data-new="79.99" data-scoop="data:image/jpeg;base64," data-filter="hue-rotate(0deg) saturate(1)">
          <div class="swatch baunilha"></div>
          <div>
            <h4>Baunilha</h4>
            <p>Suave, com toque floral de baunilha.</p>
            <div class="fprice"><span class="old">R$ 110,00</span><span class="new">R$ 79,99</span></div>
          </div>
          <div class="check">✓</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="ficha">
  <div class="wrap ficha-grid">
    <div>
      <span class="section-eyebrow">Transparência total</span>
      <h2 class="section-title" style="margin-bottom:8px;">O que tem dentro do pote.</h2>
      <p class="section-sub">Porção de 90g (5 dosadores + ½), cerca de 11 porções por embalagem de 1kg.</p>
      <div class="stat-row">
        <div class="stat"><div class="num">24g</div><div class="lbl">proteína / porção</div></div>
        <div class="stat"><div class="num">347</div><div class="lbl">kcal / porção</div></div>
        <div class="stat"><div class="num">57g</div><div class="lbl">carboidratos</div></div>
      </div>
      <ul class="ficha-list">
        <li>Apenas 0,6g de açúcares adicionados por porção</li>
        <li>Sem glúten e sem lactose adicionados na fórmula</li>
        <li>Rende cerca de 11 porções por pacote de 1kg</li>
        <li>Basta misturar em água ou leite gelado e agitar</li>
      </ul>
    </div>
    <img src="data:image/jpeg;base64," alt="Tabela de informação nutricional do Hiper Calórico">
  </div>
</section>

<section id="comprar">
  <div class="wrap">
    <div class="section-head">
      <span class="section-eyebrow">Finalize em 1 minuto</span>
      <h2 class="section-title">Monte seu pedido.</h2>
      <p class="section-sub">Escolha o sabor e a quantidade. O pagamento é só via Pix, com 5% de desconto já aplicado no total.</p>
    </div>

    <div class="checkout-card">
      <div class="checkout-top">
        <div>
          <h3>Hiper Calórico 1kg</h3>
          <p id="checkoutFlavor">Sabor: chocolate</p>
        </div>
        <div class="checkout-price">
          <div class="old mono" id="checkoutOld">R$ 120,00</div>
          <div class="new" id="checkoutNew">R$ 67,90</div>
        </div>
      </div>

      <div class="field-label">Sabor</div>
      <div class="qty-options">
        <div class="opt active" data-sync-flavor="chocolate">Chocolate</div>
        <div class="opt" data-sync-flavor="morango">Morango</div>
        <div class="opt" data-sync-flavor="baunilha">Baunilha</div>
      </div>

      <div class="field-label">Quantidade</div>
      <div class="qty-options" id="qtyOptions">
        <div class="opt active" data-qty="1">1 pote <small id="qtyLabel1">R$ 67,90 cada</small></div>
        <div class="opt" data-qty="2">2 potes <small id="qtyLabel2">R$ 64,90 cada</small></div>
        <div class="opt" data-qty="3">3 potes <small id="qtyLabel3">R$ 61,90 cada</small></div>
      </div>

      <div class="field-label">Pagamento via Pix <span style="color:var(--pix); font-weight:800;">· 5% de desconto já aplicado</span></div>

      <div class="total-row">
        <span class="lbl">Total no Pix</span>
        <span class="val" id="totalVal">R$ 64,50<small>economia de R$ 55,50 no Pix</small></span>
      </div>

      <button class="btn-buy" id="buyBtn">Finalizar compra — Pix com 5% off</button>
      <div class="checkout-foot">
        <span>🔒 Ambiente seguro</span>
        <span>🚚 Envio em até 24h</span>
        <span>↩️ Troca garantida</span>
      </div>
    </div>
  </div>
</section>

<section id="selos">
  <div class="wrap">
    <div class="selo-grid">
      <div class="selo"><div class="ic">⚡</div><h5>Energia limpa</h5><p>e nutritiva</p></div>
      <div class="selo"><div class="ic">🥇</div><h5>1º lugar 2021</h5><p>categoria hipercalórico</p></div>
      <div class="selo"><div class="ic">💎</div><h5>Qualidade Diamante</h5><p>certificação internacional</p></div>
      <div class="selo"><div class="ic">✅</div><h5>Satisfação MESC</h5><p>melhores parceiros de serviço</p></div>
    </div>
  </div>
</section>

<section id="faq">
  <div class="wrap" style="max-width:760px;">
    <div class="section-head" style="margin-bottom:28px;">
      <span class="section-eyebrow">Dúvidas frequentes</span>
      <h2 class="section-title">Perguntas antes de comprar</h2>
    </div>

    <div class="faq-item open">
      <div class="faq-q">Em quanto tempo meu pedido é enviado? <span class="plus">+</span></div>
      <div class="faq-a">Pedidos aprovados até às 16h são despachados no mesmo dia útil. Depois disso, o envio ocorre no próximo dia útil.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Como funciona o desconto no Pix? <span class="plus">+</span></div>
      <div class="faq-a">Ao escolher Pix como forma de pagamento, 5% de desconto é aplicado automaticamente sobre o valor total no momento de finalizar a compra.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Posso misturar sabores no pedido de 2 ou 3 potes? <span class="plus">+</span></div>
      <div class="faq-a">Sim. Depois de escolher a quantidade, você pode indicar a combinação de sabores desejada na etapa final da compra.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">O produto contém glúten ou lactose? <span class="plus">+</span></div>
      <div class="faq-a">A fórmula não contém derivados de glúten nem lactose adicionados. Consulte sempre o rótulo da embalagem recebida para confirmação.</div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap foot-grid">
    <div class="logo" style="font-size:16px;"><span class="dot"></span>GROWTH<span style="color:var(--gold)">.</span></div>
    <p>Página promocional criada para fins de demonstração. Suplementos alimentares não substituem uma alimentação equilibrada — consulte um profissional antes do uso.</p>
    <div class="foot-badges"><span>PIX</span><span>SSL</span></div>
  </div>
</footer>

<div class="mobile-bar">
  <span class="p">R$ 67,90</span>
  <a href="#comprar">Comprar agora</a>
</div>

<div class="pix-overlay" id="pixOverlay">
  <div class="pix-modal">
    <button class="pix-close" id="pixClose" aria-label="Fechar">✕</button>
    <div class="pix-head">
      <div class="ic">💚</div>
      <h3>Pagar com Pix</h3>
      <p id="pixOrderLine">Hiper Calórico 1kg · sabor chocolate</p>
    </div>

    <div class="pix-summary">
      <span class="l">Total a pagar</span>
      <span class="v" id="pixTotal">R$ 67,90</span>
    </div>

    <div class="pix-qr-wrap">
      <div id="pixQrcode"></div>
    </div>

    <div class="pix-code-label">Pix copia e cola</div>
    <div class="pix-code-box">
      <textarea id="pixCode" readonly>00020101021226820014br.gov.bcb.pix2560qrcode.a55scd.com.br/v1/b9122749-1f95-408f-abab-1868c82c9abe5204000053039865802BR5910BRIPAKLTDA6008SAOPAULO62070503***6304C95B</textarea>
      <button class="pix-copy-btn" id="pixCopyBtn">Copiar</button>
    </div>

    <ul class="pix-steps">
      <li><span class="n">1</span> Abra o app do seu banco e escolha pagar com Pix.</li>
      <li><span class="n">2</span> Escaneie o QR code acima ou use "Pix Copia e Cola".</li>
      <li><span class="n">3</span> Confirme o valor e finalize o pagamento.</li>
    </ul>
  </div>
</div>

<script>
  const flavorNames = {chocolate:'chocolate', morango:'morango', baunilha:'baunilha'};
  const flavorCards = document.querySelectorAll('.flavor-card');
  const flavorImg = document.getElementById('flavorImg');
  const flavorNote = document.getElementById('flavorNote');
  const checkoutFlavor = document.getElementById('checkoutFlavor');
  const checkoutOld = document.getElementById('checkoutOld');
  const checkoutNew = document.getElementById('checkoutNew');
  const syncFlavorOpts = document.querySelectorAll('[data-sync-flavor]');
  const qtyOptions = document.querySelectorAll('#qtyOptions .opt');
  const totalVal = document.getElementById('totalVal');
  const buyBtn = document.getElementById('buyBtn');
  const qtyLabels = [null, document.getElementById('qtyLabel1'), document.getElementById('qtyLabel2'), document.getElementById('qtyLabel3')];

  function fmt(n){
    return 'R$ ' + n.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
  }

  let state = { flavor:'chocolate', qty:1 };

  // ---- Flavor selector: swap to the real product photo when available, otherwise recolor the base photo ----
  function setFlavor(flavor){
    const card = document.querySelector('.flavor-card[data-flavor="'+flavor+'"]');
    if(!card) return;
    state.flavor = flavor;

    flavorCards.forEach(c=>c.classList.remove('active'));
    card.classList.add('active');

    if(card.dataset.scoop){
      flavorImg.src = card.dataset.scoop;
      flavorImg.style.filter = 'none';
    } else {
      flavorImg.style.filter = card.dataset.filter;
    }

    flavorNote.textContent = 'sabor selecionado: ' + flavorNames[flavor];
    checkoutFlavor.textContent = 'Sabor: ' + flavorNames[flavor];
    checkoutOld.textContent = fmt(parseFloat(card.dataset.old));
    checkoutNew.textContent = fmt(parseFloat(card.dataset.new));

    syncFlavorOpts.forEach(o=>o.classList.toggle('active', o.dataset.syncFlavor === flavor));
    updateQtyLabels();
    updateTotal();
  }

  flavorCards.forEach(card=>{
    card.addEventListener('click', ()=> setFlavor(card.dataset.flavor));
  });
  syncFlavorOpts.forEach(opt=>{
    opt.addEventListener('click', ()=> setFlavor(opt.dataset.syncFlavor));
  });

  // ---- Quantity tiers: R$3 de desconto por pote adicional, sobre o preço do sabor escolhido ----
  function unitPriceForQty(qty){
    const card = document.querySelector('.flavor-card[data-flavor="'+state.flavor+'"]');
    const base = parseFloat(card.dataset.new);
    return Math.max(base - (qty-1)*3, base*0.85);
  }

  function updateQtyLabels(){
    [1,2,3].forEach(q=>{
      qtyLabels[q].textContent = fmt(unitPriceForQty(q)) + ' cada';
    });
  }

  qtyOptions.forEach(opt=>{
    opt.addEventListener('click', ()=>{
      qtyOptions.forEach(o=>o.classList.remove('active'));
      opt.classList.add('active');
      state.qty = parseInt(opt.dataset.qty);
      updateTotal();
    });
  });

  function updateTotal(){
    const unit = unitPriceForQty(state.qty);
    const subtotal = state.qty * unit;
    const total = subtotal * 0.95;
    const savings = subtotal - total;
    totalVal.innerHTML = fmt(total) + '<small>economia de ' + fmt(savings) + ' no Pix</small>';
  }

  updateQtyLabels();
  updateTotal();

  // ---- Pix payment modal ----
  const CHOC_PIX = "00020101021226820014br.gov.bcb.pix2560qrcode.a55scd.com.br/v1/b9122749-1f95-408f-abab-1868c82c9abe5204000053039865802BR5910BRIPAKLTDA6008SAOPAULO62070503***6304C95B";
  const MORANGO_PIX = "00020101021226820014br.gov.bcb.pix2560qrcode.a55scd.com.br/v1/36d7be73-f283-4e88-a0b3-2a4dc0def6045204000053039865802BR5910BRIPAKLTDA6008SAOPAULO62070503***63049677";
  const BAUNILHA_PIX = "00020101021226820014br.gov.bcb.pix2560qrcode.a55scd.com.br/v1/831d5707-d8c0-4b68-ac20-e46ec6ca631c5204000053039865802BR5910BRIPAKLTDA6008SAOPAULO62070503***63042507";
  const PIX_CODES = {
    chocolate: CHOC_PIX,
    morango: MORANGO_PIX,
    baunilha: BAUNILHA_PIX
  };
  const pixOverlay = document.getElementById('pixOverlay');
  const pixClose = document.getElementById('pixClose');
  const pixOrderLine = document.getElementById('pixOrderLine');
  const pixTotal = document.getElementById('pixTotal');
  const pixCode = document.getElementById('pixCode');
  const pixCopyBtn = document.getElementById('pixCopyBtn');
  const pixQrEl = document.getElementById('pixQrcode');

  function currentTotalValue(){
    const unit = unitPriceForQty(state.qty);
    const raw = (state.qty * unit) * 0.95;
    return Math.round(raw * 100) / 100; // arredonda em centavos p/ o valor exibido e o embutido no Pix baterem sempre
  }

  // CRC16-CCITT (FFFF), padrão exigido pelo BR Code do Pix
  function crc16ccitt(str){
    let crc = 0xFFFF;
    for(let i=0; i<str.length; i++){
      crc ^= (str.charCodeAt(i) << 8);
      for(let j=0; j<8; j++){
        crc = (crc & 0x8000) ? ((crc << 1) ^ 0x1021) : (crc << 1);
        crc &= 0xFFFF;
      }
    }
    return crc.toString(16).toUpperCase().padStart(4, '0');
  }

  // Insere o campo 54 (valor da transação) no payload EMV e recalcula o CRC (campo 63)
  function buildPixWithAmount(baseCode, amount){
    const core = baseCode.slice(0, -8); // remove o campo 63 antigo (id+len+crc = 8 chars)
    const amountStr = amount.toFixed(2);
    const amountField = '54' + String(amountStr.length).padStart(2, '0') + amountStr;
    const insertPoint = core.indexOf('5802BR');
    if(insertPoint === -1) return baseCode; // fallback de segurança
    const newCore = core.slice(0, insertPoint) + amountField + core.slice(insertPoint);
    const toChecksum = newCore + '6304';
    return toChecksum + crc16ccitt(toChecksum);
  }

  function openPixModal(){
    const qtyLabel = state.qty === 1 ? '1 pote' : state.qty + ' potes';
    pixOrderLine.textContent = 'Hiper Calórico ' + qtyLabel + ' · sabor ' + flavorNames[state.flavor];

    const amount = currentTotalValue();
    pixTotal.textContent = fmt(amount);

    const baseCode = PIX_CODES[state.flavor] || CHOC_PIX;
    const code = buildPixWithAmount(baseCode, amount);
    pixCode.value = code;

    if(window.QRCode){
      pixQrEl.innerHTML = '';
      new QRCode(pixQrEl, {
        text: code,
        width: 200,
        height: 200,
        colorDark: "#0E0B14",
        colorLight: "#ffffff"
      });
    }

    pixOverlay.classList.add('open');
  }

  function closePixModal(){
    pixOverlay.classList.remove('open');
  }

  buyBtn.addEventListener('click', openPixModal);
  pixClose.addEventListener('click', closePixModal);
  pixOverlay.addEventListener('click', (e)=>{ if(e.target === pixOverlay) closePixModal(); });

  pixCopyBtn.addEventListener('click', ()=>{
    pixCode.select();
    pixCode.setSelectionRange(0, 99999);
    const finish = ()=>{
      pixCopyBtn.textContent = 'Copiado!';
      pixCopyBtn.classList.add('copied');
      setTimeout(()=>{ pixCopyBtn.textContent = 'Copiar'; pixCopyBtn.classList.remove('copied'); }, 2000);
    };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(pixCode.value).then(finish).catch(()=>{
        document.execCommand('copy'); finish();
      });
    } else {
      document.execCommand('copy'); finish();
    }
  });

  // ---- FAQ accordion ----
  document.querySelectorAll('.faq-item').forEach(item=>{
    item.querySelector('.faq-q').addEventListener('click', ()=>{
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
      if(!isOpen) item.classList.add('open');
    });
  });
</script>

</body>
</html>
